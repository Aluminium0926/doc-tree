{
  "name": "doc-tree",
  "productName": "文档树",
  "version": "1.0.11",
  "private": true,
  "description": "本地文档阅读器 + 锚定原文的追问树",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server.mjs",
    "app": "electron .",
    "mock": "node scripts/mock-llm.mjs",
    "e2e": "node scripts/e2e.mjs",
    "dist": "electron-packager . DocTree --platform=win32 --arch=x64 --out=release --overwrite --asar=false --prune=true --ignore=^/release --ignore=^/\\.npm-cache --ignore=^/scripts --ignore=^/docs"
  },
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^1.2.0",
    "katex": "^0.19.1",
    "mammoth": "^1.13.0",
    "marked": "^18.1.3",
    "pdf-to-img": "^7.0.2",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-packager": "^17.1.2",
    "puppeteer-core": "^25.16.0"
  }
}
